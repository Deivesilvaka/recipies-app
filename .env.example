# port
PORT=3000

# APP
APP_NAME="Recipes App"

# environment
NODE_ENV=local
# Gere um segredo forte e aleatório, nunca reutilize o valor de exemplo abaixo em produção.
JWT_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio

CURRENT_URL=http://localhost:3000

# db
DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=root
DB_USERNAME=root
DB_NAME=recipes_app

#serviço usado para teste é o mailtrap https://mailtrap.io/

MAIL_HOST=sandbox.smtp.mailtrap.io
